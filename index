<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mz Cell – Controle</title>
<style>
:root{--bg:#f3f5f9;--sf:#fff;--tx:#18202b;--mu:#667085;--bd:#e1e5ec;--ac:#1d4ed8;--hd:#0f1e3d;--ok:#13795b;--bad:#c0392b;--zb:#f8f9fc;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10141a;--sf:#1a2029;--tx:#e8ecf2;--mu:#98a2b3;--bd:#2c3542;--ac:#6ea0ff;--hd:#0a1020;--ok:#4cc38a;--bad:#ef6f61;--zb:#1f2631}}
:root[data-theme="dark"]{--bg:#10141a;--sf:#1a2029;--tx:#e8ecf2;--mu:#98a2b3;--bd:#2c3542;--ac:#6ea0ff;--hd:#0a1020;--ok:#4cc38a;--bad:#ef6f61;--zb:#1f2631}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:14px/1.4 Arial,Helvetica,sans-serif;font-variant-numeric:tabular-nums}
header{background:var(--hd);color:#fff;padding:16px 20px;display:flex;align-items:center;gap:12px}
header h1{font-size:18px;margin:0;letter-spacing:.3px}header small{color:#9fb0d0}#st{margin-left:auto;font-size:12px;color:#9fb0d0}
.logo{width:36px;height:36px;border-radius:9px;background:linear-gradient(135deg,#3b82f6,#1d4ed8);display:grid;place-items:center;font-weight:bold}
nav{display:flex;gap:2px;overflow-x:auto;padding:0 16px;background:var(--sf);border-bottom:1px solid var(--bd);position:sticky;top:env(safe-area-inset-top,0px);z-index:5}
nav button{border:0;border-bottom:3px solid transparent;background:none;color:var(--mu);padding:12px 16px;white-space:nowrap;font:inherit;font-weight:bold;cursor:pointer}
nav button.on{color:var(--ac);border-color:var(--ac)}
main{padding:18px 16px 40px;max-width:1150px;margin:auto}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:16px}
.card{background:var(--sf);border:1px solid var(--bd);border-left:4px solid var(--ac);border-radius:10px;padding:14px;box-shadow:0 1px 2px rgba(16,24,40,.05)}
.card.g{border-left-color:var(--ok)}.card.r{border-left-color:var(--bad)}
.card b{display:block;font-size:21px;margin-top:6px}.card span{color:var(--mu);font-size:12px;text-transform:uppercase;letter-spacing:.4px}
.box{background:var(--sf);border:1px solid var(--bd);border-radius:10px;padding:16px;margin-bottom:16px;box-shadow:0 1px 2px rgba(16,24,40,.05)}
h2{font-size:15px;margin:0 0 10px}.w{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:560px}
th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--mu);padding:8px 4px;border-bottom:2px solid var(--bd);white-space:nowrap}
td{padding:3px 4px;border-bottom:1px solid var(--bd)}tbody tr:nth-child(even){background:var(--zb)}
tfoot td{font-weight:bold;padding:9px 4px;border-top:2px solid var(--bd)}tr.t td{font-weight:bold;background:var(--zb)}
input,select{width:100%;min-width:70px;box-sizing:border-box;font:inherit;color:var(--tx);background:var(--sf);border:1px solid var(--bd);border-radius:6px;padding:6px}
input:focus,select:focus{outline:2px solid var(--ac);border-color:transparent}input[type=number]{min-width:80px}.c{padding:6px 4px;white-space:nowrap}
.add{margin-top:10px;border:1px solid var(--ac);background:none;color:var(--ac);padding:8px 14px;border-radius:8px;font:inherit;font-weight:bold;cursor:pointer}
.x{border:0;background:none;color:var(--bad);font-size:18px;cursor:pointer}
.neg{color:var(--bad)}.pos{color:var(--ok)}.row{display:flex;gap:12px;flex-wrap:wrap}.row label{font-size:12px;color:var(--mu);flex:1;min-width:120px}
.bars{display:flex;align-items:flex-end;gap:6px;height:130px;padding-top:6px}.bars div{flex:1;text-align:center;font-size:11px;color:var(--mu)}.bars i{display:block;border-radius:4px 4px 0 0;background:var(--ok);min-height:2px}.bars i.n{background:var(--bad)}
#md{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:20;align-items:center;justify-content:center;padding:16px;overflow:auto}
.mb{background:var(--sf);border-radius:12px;padding:20px;width:100%;max-width:660px;max-height:90vh;overflow:auto}
.gr{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.fg label{display:block;font-size:12px;color:var(--mu);margin-bottom:4px}.ro{padding:7px 0;font-weight:bold}
.ac{display:flex;gap:8px;margin-top:18px;align-items:center}.ac .add{margin:0}.add.p{background:var(--ac);color:#fff}.add.s{margin:0;padding:4px 10px;font-size:12px}
.bar{display:flex;gap:10px;align-items:center;margin-bottom:10px;flex-wrap:wrap}.bar h2{margin:0;flex:1}.bar .add{margin:0}.se{width:200px}
.rw{cursor:pointer}.rw:hover{background:var(--zb)}.q{border:1px solid var(--bd);background:var(--sf);color:var(--tx);border-radius:6px;width:26px;height:26px;cursor:pointer;font-size:15px}
.b{padding:3px 9px;border-radius:12px;font-size:12px;font-weight:bold;white-space:nowrap}.b.ok{background:#d6f3e6;color:#0b6b48}.b.wa{background:#fdeccb;color:#8a5a00}.b.in{background:#e1e8f5;color:#31456e}
.nw{display:grid;grid-template-columns:minmax(300px,1fr) minmax(320px,1.1fr);gap:16px;align-items:start}@media(max-width:850px){.nw{grid-template-columns:1fr}}
.it{display:grid;grid-template-columns:1fr 70px 100px 30px;gap:6px;margin-bottom:6px}.b.rd{background:#fbd8d4;color:#9b2a1d}
.nota{background:#fff;color:#111;border:1px solid var(--bd);border-radius:10px;padding:24px}.nota td,.nota th,.nota tfoot td{color:#111;border-color:#ddd}.nota tr{background:none!important}.nota small{color:#555}
.nh{display:flex;justify-content:space-between;border-bottom:2px solid #111;padding-bottom:10px;margin-bottom:12px}.ng{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.ns{display:flex;gap:40px;margin-top:50px;text-align:center}.ns div{flex:1;border-top:1px solid #111;padding-top:4px;font-size:12px}
@media print{header,nav,.noprint,.add,.x,#md{display:none!important}body{background:#fff}main{padding:0;max-width:none}.nw{display:block}.nota{border:0}}
</style></head>
<body>
<header><div class="logo">Mz</div><div><h1>Mz Cell</h1><small>Gestão de estoque, serviços e resultados</small></div><span id="st"></span></header>
<nav id="nav"></nav><main id="app"></main><div id="md"></div>
<script>
const F=n=>(+n||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const E=s=>String(s??'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
const N=v=>+v||0;
const P=(c,a)=>a.map(([mod,q])=>({cat:c,mod,q}));
const AC=f=>[...f,['q','Qtd','n'],['cu','Custo un.','m'],['vu','Venda un.','m'],['tc','Total custo','=',r=>N(r.q)*N(r.cu)],['tv','Total venda','=',r=>N(r.q)*N(r.vu)],['lp','Lucro potencial','=',r=>N(r.q)*(N(r.vu)-N(r.cu))]];
const T={
comuns:{n:'Películas comuns',c:AC([['cat','Categoria'],['mod','Modelo / compatibilidade']])},
priv:{n:'Películas de privacidade',c:AC([['cat','Categoria'],['mod','Modelo / compatibilidade']])},
capas:{n:'Capinhas',c:AC([['mod','Modelo'],['cor','Cor']])},
cel:{n:'Celulares em estoque',c:[['marca','Marca'],['mod','Modelo'],['cond','Condição','s',['Novo','Seminovo','Usado']],['cor','Cor'],['arm','Armazenamento'],['ram','RAM'],['tela','Tela'],['cam','Câmera'],['bat','Bateria'],['cpu','Processador'],['sb','Saúde da bateria'],['imei','IMEI'],['custo','Custo','m'],['venda','Venda','m'],['lucro','Lucro','=',r=>N(r.venda)-N(r.custo)],['st','Status','s',['Em estoque','Reservado','Vendido']],['obs','Observações']]},
caixa:{n:'Movimentações do caixa',c:[['data','Data','d'],['tipo','Tipo','s',['Entrada','Saída']],['cat','Categoria','s',['Venda','Conserto','Película/Acessório','Aparelho','Peças','Aluguel','Retirada','Outros']],['desc','Descrição'],['forma','Forma','s',['Dinheiro','Pix','Cartão','Fiado']],['val','Valor','m'],['sg','Efeito no caixa','=',r=>r.tipo==='Saída'?-N(r.val):N(r.val)]]},
ped:{n:'Pedidos / Solicitações',c:[['cli','Cliente'],['data','Data','d'],['mod','Modelo'],['pel','Película'],['capa','Capinha/Cor'],['pc','Peças','n'],['custo','Custo','m'],['venda','Venda','m'],['lucro','Lucro','=',r=>N(r.venda)-N(r.custo)]]},
cons:{n:'Consertos',c:[['cod','Código'],['cli','Cliente'],['ap','Aparelho'],['tel','Telefone'],['serv','Serviço'],['data','Data','d'],['st','Status','s',['Aguardando','Em conserto','Pronto','Entregue']],['custo','Custo','m'],['vp','Valor Peça','m'],['mo','Mão de obra','m'],['total','Total','=',r=>N(r.vp)+N(r.mo)],['lucro','Lucro','=',r=>N(r.vp)+N(r.mo)-N(r.custo)],['pg','Pagamento']]},
vend:{n:'Vendas',c:[['cli','Comprador'],['tel','Telefone'],['ap','Aparelho'],['imei','IMEI'],['data','Data','d'],['val','Valor','m'],['custo','Custo','m'],['lucro','Lucro','=',r=>N(r.val)-N(r.custo)],['fp','Forma de pagamento'],['pago','Já recebido','m'],['resta','Resta','=',r=>N(r.val)-N(r.pago)],['st','Status','s',['Anunciado','Recebendo pagamento','Vendido e pago']]]}
};
const seed=()=>({cfg:{pc:10,pp:20,vc:'',vp:''},
comuns:[...P('iPhone',[['XR / iPhone 11',1],['iPhone 13 / 13 Pro / 14 / 16e / 17e',3],['iPhone 12 / 12 Pro',2],['XS / iPhone 11 Pro',1],['iPhone 16',1],['iPhone 15 / 15 Pro',2]]),
...P('Samsung',[['A54 / S23 FE',1],['A05s',1],['A36 / A56 / S24 FE',1],['A24 / A25',1],['A15',1],['A32 4G',4]]),
...P('Motorola',[['G14 / G54 / G64',4],['G04 / G24 / E14',1],['G04',1],['G22 / E32',1],['G31 / G41 / G71',1]]),
...P('Xiaomi / Redmi / POCO',[['Redmi 14C / Redmi A5 / Redmi A7 / POCO C75',1],['A05 / Redmi 13C',1],['Redmi Note 12 4G',1]])],
priv:P('iPhone',[['iPhone 13 / 13 Pro',2],['iPhone 12 / 12 Pro',1],['iPhone XR / 11',1]]),
capas:[],ped:[],cons:[],
vend:[{cli:'Alex',tel:'24 99212-4462',ap:'Samsung A32 4G',imei:'',val:650,fp:'Fiado',pago:200,st:'Recebendo pagamento'},
{cli:'Pierre',tel:'24 99298-0563',ap:'iPhone XR',imei:'',val:1000,fp:'Fiado + A07',pago:760,st:'Anunciado'},
{cli:'Evellyn',tel:'24 99202-2413',ap:'iPhone 13',imei:'',val:2000,fp:'Pix + XR',pago:2000,st:'Vendido e pago'},
],cel:[{mod:'A07',imei:'351880401712682',venda:650,st:'Em estoque'}],caixa:[],notas:[]});
let D=seed(),tab='painel',ref=null;
const sum=(a,f)=>a.reduce((s,r)=>s+f(r),0);
function stat(t){document.getElementById('st').textContent=t}
function save(){try{localStorage.setItem('mzcell',JSON.stringify(D))}catch(e){}
 if(ref){stat('salvando…');ref.set({j:JSON.stringify(D)}).then(()=>stat('✓ salvo'),()=>stat('salvo só neste aparelho'))}else stat('salvo só neste aparelho')}
const MS=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
let Y=new Date().getFullYear();
function stock(){const A=[...D.comuns,...D.priv,...D.capas],c=D.cel.filter(r=>r.st!=='Vendido'),ac=sum(A,r=>N(r.q)*N(r.cu)),av=sum(A,r=>N(r.q)*N(r.vu));return{q:sum([...D.comuns,...D.priv],r=>N(r.q)),cap:sum(D.capas,r=>N(r.q)),ac,av,cust:ac+sum(c,r=>N(r.custo)),venda:av+sum(c,r=>N(r.venda))}}
function res(y){const m=Array.from({length:12},()=>({r:0,c:0})),o={cons:{r:0,c:0},ped:{r:0,c:0},vend:{r:0,c:0}};let sd=0;
 const add=(k,a,fr,fc)=>a.forEach(r=>{if(r.cli==='(estoque)')return;const R=fr(r),C=fc(r),d=r.data;if(!R&&!C)return;if(!d){sd++;return}if(+d.slice(0,4)!==y)return;const i=+d.slice(5,7)-1;if(i<0||i>11)return;m[i].r+=R;m[i].c+=C;o[k].r+=R;o[k].c+=C});
 add('cons',D.cons,r=>N(r.vp)+N(r.mo),r=>N(r.custo));add('ped',D.ped,r=>N(r.venda),r=>N(r.custo));add('vend',D.vend,r=>N(r.val),r=>N(r.custo));return{m,o,sd}}
const C=(l,v,c)=>`<div class="card ${c||''}"><span>${l}</span><b>${v}</b></div>`;
const L=(r,c)=>{const l=r-c;return`<td>${F(r)}</td><td>${F(c)}</td><td class="${l<0?'neg':'pos'}">${F(l)}</td><td>${r?(l/r*100).toFixed(1)+'%':'–'}</td>`};
function panel(){const s=stock(),R=res(new Date().getFullYear()),mi=new Date().getMonth(),ym=R.m[mi],ya=R.m.reduce((a,x)=>({r:a.r+x.r,c:a.c+x.c}),{r:0,c:0});
 const dev=D.vend.filter(r=>N(r.val)-N(r.pago)>0&&r.cli&&r.cli!=='(estoque)'),rec=sum(dev,r=>N(r.val)-N(r.pago)),ab=D.cons.filter(r=>r.cli&&r.st!=='Entregue').length;
 return`<div class="cards">${C('Estoque a custo',F(s.cust))}${C('Potencial de venda do estoque',F(s.venda),'g')}${C('Lucro no mês',F(ym.r-ym.c),ym.r-ym.c<0?'r':'g')}${C('Lucro no ano',F(ya.r-ya.c),ya.r-ya.c<0?'r':'g')}${C('A receber (fiado)',F(rec),'r')}${C('Consertos em aberto',ab)}</div>
 <div class="box"><h2>Atalhos</h2><div class="row"><button class="add" data-new="vend">+ Nova venda</button><button class="add" data-new="cons">+ Novo conserto</button><button class="add" data-new="ped">+ Novo pedido</button><button class="add" data-tab="nota">+ Nova nota</button><button class="add" data-new="caixa">+ Lançar no caixa</button></div></div>
 <div class="box"><h2>Quem ainda deve</h2>${dev.length?dev.map(r=>`<div>${E(r.cli)} – ${E(r.ap)}: <b class="neg">${F(N(r.val)-N(r.pago))}</b> <small>${E(r.tel)}</small></div>`).join(''):'<small>Ninguém devendo 🎉</small>'}</div>`}
function est(){const s=stock();return`<div class="cards">${C('Películas em estoque',s.q+' un.')}${C('Capinhas em estoque',s.cap+' un.')}${C('Valor a custo',F(s.ac))}${C('Valor de venda',F(s.av),'g')}${C('Lucro potencial',F(s.av-s.ac),'g')}</div><p><small>Informe custo e venda de cada item no cadastro: o sistema calcula custo total, venda e lucro do estoque.</small></p>`+tbl('comuns')+tbl('priv')+tbl('capas')}
function celv(){const a=D.cel.filter(r=>r.st!=='Vendido'),cu=sum(a,r=>N(r.custo)),ve=sum(a,r=>N(r.venda));return`<div class="cards">${C('Aparelhos em estoque',a.length)}${C('Custo',F(cu))}${C('Valor de venda',F(ve),'g')}${C('Lucro potencial',F(ve-cu),'g')}</div>`+tbl('cel')}
let CM=new Date().toISOString().slice(0,7);
function cx(){const a=D.caixa,mm=a.filter(r=>(r.data||'').slice(0,7)===CM),en=sum(mm.filter(r=>r.tipo!=='Saída'),r=>N(r.val)),sa=sum(mm.filter(r=>r.tipo==='Saída'),r=>N(r.val)),tot=sum(a,r=>T.caixa.c[6][3](r));
 return`<div class="box"><label>Mês <input type="month" data-cm="1" value="${CM}" style="width:auto"></label></div><div class="cards">${C('Saldo atual do caixa',F(tot),tot<0?'r':'g')}${C('Entradas no mês',F(en),'g')}${C('Saídas no mês',F(sa),'r')}${C('Resultado do mês',F(en-sa),en-sa<0?'r':'g')}</div>`+tbl('caixa')}
const nNew=()=>({num:'',data:new Date().toISOString().slice(0,10),cli:'',tel:'',doc:'',ap:'',imei:'',serv:'',itens:[{d:'',q:1,v:''}],pg:'',gar:'90 dias',obs:''});
let NT=nNew();const nTot=n=>sum(n.itens,i=>N(i.q)*N(i.v)),np=()=>{document.getElementById('np').innerHTML=npv()};
function npv(){const n=NT;return`<div class="nota"><div class="nh"><div><h2 style="font-size:22px;margin:0">Mz Cell</h2><div>${E(D.cfg.loja||'Assistência técnica e acessórios')}</div></div><div style="text-align:right"><b>NOTA DE SERVIÇO</b><br>Nº ${E(n.num||'N'+String(D.notas.length+1).padStart(4,'0'))}<br>${fd(n.data)}</div></div>
<div class="ng"><div><small>Cliente</small><br><b>${E(n.cli)||'—'}</b></div><div><small>Telefone</small><br>${E(n.tel)||'—'}</div><div><small>CPF</small><br>${E(n.doc)||'—'}</div><div><small>Aparelho</small><br>${E(n.ap)||'—'}${n.imei?' · IMEI '+E(n.imei):''}</div></div>
${n.serv?`<p><small>Serviço / defeito relatado</small><br>${E(n.serv)}</p>`:''}
<table style="min-width:0"><thead><tr><th>Descrição</th><th>Qtd</th><th>Unit.</th><th>Total</th></tr></thead><tbody>${n.itens.filter(i=>i.d||i.v).map(i=>`<tr><td>${E(i.d)}</td><td>${N(i.q)}</td><td>${F(i.v)}</td><td>${F(N(i.q)*N(i.v))}</td></tr>`).join('')}</tbody><tfoot><tr><td colspan="3" style="text-align:right">TOTAL</td><td>${F(nTot(n))}</td></tr></tfoot></table>
<p><small>Pagamento:</small> ${E(n.pg)||'—'} &nbsp; <small>Garantia:</small> ${E(n.gar)||'—'}</p>${n.obs?`<p>${E(n.obs)}</p>`:''}<div class="ns"><div>Assinatura do cliente</div><div>Mz Cell</div></div><p style="text-align:center;font-size:12px;color:#555">Obrigado pela preferência!</p></div>`}
function notav(){const n=NT,f=(k,l,t)=>`<div class="fg"><label>${l}</label><input data-n="${k}" ${t||''} value="${E(n[k])}"></div>`;
 return`<div class="nw"><div class="noprint"><div class="box"><h2>Dados da nota</h2><div class="gr">${f('data','Data','type="date"')}${f('cli','Cliente')}${f('tel','Telefone')}${f('doc','CPF (opcional)')}${f('ap','Aparelho')}${f('imei','IMEI (opcional)')}</div>
<div class="gr" style="margin-top:12px">${f('serv','Serviço / defeito')}</div><h2 style="margin-top:14px">Itens</h2>${n.itens.map((i,x)=>`<div class="it"><input placeholder="Descrição (peça, serviço, película…)" data-ni="${x}" data-nf="d" value="${E(i.d)}"><input type="number" data-ni="${x}" data-nf="q" value="${E(i.q)}"><input type="number" step="0.01" placeholder="Valor" data-ni="${x}" data-nf="v" value="${E(i.v)}"><button class="x" data-nrm="${x}">×</button></div>`).join('')}<button class="add" data-nadd>+ Item</button>
<div class="gr" style="margin-top:12px">${f('pg','Forma de pagamento')}${f('gar','Garantia')}${f('obs','Observações')}<div class="fg"><label>Contato da loja (cabeçalho)</label><input data-cfg="loja" value="${E(D.cfg.loja)}"></div></div>
<div class="ac" style="flex-wrap:wrap"><button class="add p" data-npr>🖨 Imprimir / PDF</button><button class="add" data-nsv>Salvar nota</button><button class="add" data-ncx>Lançar no caixa</button><button class="add" data-nnew>Nova nota</button></div></div>
<div class="box"><h2>Notas salvas</h2><div class="w"><table style="min-width:0"><thead><tr><th>Nº</th><th>Data</th><th>Cliente</th><th>Total</th></tr></thead><tbody>${D.notas.map((x,i)=>`<tr class="rw" data-nl="${i}"><td>${E(x.num)}</td><td>${fd(x.data)}</td><td>${E(x.cli)}</td><td>${F(nTot(x))}</td></tr>`).reverse().join('')||'<tr><td colspan="4"><small>Nenhuma nota salva.</small></td></tr>'}</tbody></table></div></div></div><div id="np">${npv()}</div></div>`}
function resu(){const R=res(Y),m=R.m,sm=(a,b)=>m.slice(a,b).reduce((x,y)=>({r:x.r+y.r,c:x.c+y.c}),{r:0,c:0}),S1=sm(0,6),S2=sm(6,12),A=sm(0,12),mx=Math.max(1,...m.map(x=>Math.abs(x.r-x.c)));
 const tr=(n,x,t)=>`<tr${t?' class="t"':''}><td>${n}</td>${L(x.r,x.c)}</tr>`,H='<thead><tr><th>Período</th><th>Receita</th><th>Custo</th><th>Lucro</th><th>Margem</th></tr></thead>';
 const yrs=[2025,2026,2027,2028,2029,2030];
 return`<div class="box"><label>Ano <select data-y="1" style="width:auto">${yrs.map(y=>`<option${y===Y?' selected':''}>${y}</option>`).join('')}</select></label></div>
 <div class="cards">${C('Receita do ano',F(A.r))}${C('Custo do ano',F(A.c))}${C('Lucro do ano',F(A.r-A.c),A.r-A.c<0?'r':'g')}${C('1º semestre',F(S1.r-S1.c))}${C('2º semestre',F(S2.r-S2.c))}</div>
 <div class="box"><h2>Lucro por mês – ${Y}</h2><div class="bars">${m.map((x,i)=>{const l=x.r-x.c;return`<div><i class="${l<0?'n':''}" style="height:${Math.abs(l)/mx*100}px"></i>${MS[i].slice(0,3)}</div>`}).join('')}</div></div>
 <div class="box"><h2>Resultado mensal, semestral e anual</h2><div class="w"><table>${H}<tbody>${m.map((x,i)=>tr(MS[i],x)).join('')}${tr('1º semestre',S1,1)}${tr('2º semestre',S2,1)}${tr('Ano '+Y,A,1)}</tbody></table></div></div>
 <div class="box"><h2>Por origem – ${Y}</h2><div class="w"><table>${H}<tbody>${tr('Consertos',R.o.cons)}${tr('Pedidos (películas/capinhas)',R.o.ped)}${tr('Vendas de aparelhos',R.o.vend)}</tbody></table></div><small>${R.sd?R.sd+' lançamento(s) sem data ficam fora dos resultados – preencha a coluna Data. ':''}Vendas: informe o Custo do aparelho para o lucro sair correto.</small></div>`}
const LS={comuns:['cat','mod','q','cu','vu','lp'],priv:['cat','mod','q','cu','vu','lp'],capas:['mod','cor','q','cu','vu','lp'],cel:['marca','mod','arm','ram','cor','cond','custo','venda','lucro','st'],caixa:['data','tipo','cat','desc','forma','sg'],ped:['cli','data','mod','pel','capa','venda','lucro'],cons:['cod','cli','ap','serv','data','st','total','lucro'],vend:['cli','ap','data','val','pago','resta','st']};
const Q={},BC={'Em estoque':'ok','Reservado':'wa','Entrada':'ok','Saída':'rd','Entregue':'ok','Vendido e pago':'ok','Pronto':'ok','Em conserto':'wa','Recebendo pagamento':'wa'};let M={};
const fd=d=>d?d.split('-').reverse().join('/'):'';
function cell(k,r,i,[f,,ty,x]){const v=r[f]??'';
 if(ty==='=')return`<td class="c">${F(x(r))}</td>`;
 if(ty==='m')return`<td class="c">${v===''?'':F(v)}</td>`;
 if(ty==='d')return`<td class="c">${fd(v)}</td>`;
 if(ty==='s')return`<td>${v?`<span class="b ${BC[v]||'in'}">${E(v)}</span>`:''}</td>`;
 if(ty==='n'&&f==='q')return`<td class="c"><button class="q" data-q="-1" data-k="${k}" data-i="${i}">−</button> <b>${N(v)}</b> <button class="q" data-q="1" data-k="${k}" data-i="${i}">+</button></td>`;
 return`<td>${E(v)}</td>`}
function lst(k){const t=T[k],cols=LS[k].map(f=>t.c.find(c=>c[0]===f)),q=(Q[k]||'').toLowerCase(),rows=D[k].map((r,i)=>[r,i]).filter(([r])=>!q||JSON.stringify(Object.values(r)).toLowerCase().includes(q));
 const body=rows.map(([r,i])=>`<tr class="rw" data-edit="${k}" data-i="${i}">${cols.map(c=>cell(k,r,i,c)).join('')}${k==='vend'&&r.cli&&r.cli!=='(estoque)'&&N(r.val)-N(r.pago)>0?`<td class="c"><button class="add s" data-pay="${i}">Receber</button></td>`:'<td></td>'}</tr>`).join('')||'<tr><td colspan="9"><small>Nenhum registro. Use “+ Novo”.</small></td></tr>';
 const foot=cols.map((c,j)=>{const ty=c[2],g=r=>ty==='='?c[3](r):N(r[c[0]]);return`<td>${j===0?'Total ('+rows.length+')':ty==='n'?sum(rows,([r])=>g(r)):ty==='m'||ty==='='?F(sum(rows,([r])=>g(r))):''}</td>`}).join('');
 return`<table><thead><tr>${cols.map(c=>`<th>${c[1]}</th>`).join('')}<th></th></tr></thead><tbody>${body}</tbody><tfoot><tr>${foot}<td></td></tr></tfoot></table>`}
function tbl(k){return`<div class="box"><div class="bar"><h2>${T[k].n}</h2><input class="se" placeholder="Buscar…" data-s="${k}" value="${E(Q[k]||'')}"><button class="add" data-new="${k}">+ Novo</button></div><div class="w" id="L-${k}">${lst(k)}</div></div>`}
function openM(k,i){const t=T[k],r=i<0?{}:D[k][i];M={k,i};
 const fs=t.c.map(([f,l,ty,x])=>{const v=r[f]??'';let h;
  if(ty==='=')h=`<div class="ro" id="r-${f}">${F(x(r))}</div>`;
  else if(ty==='s')h=`<select id="f-${f}"><option></option>${x.map(o=>`<option${o===v?' selected':''}>${o}</option>`).join('')}</select>`;
  else h=`<input id="f-${f}" type="${ty==='n'||ty==='m'?'number':ty==='d'?'date':'text'}"${ty==='m'?' step="0.01"':''} value="${E(v)}">`;
  return`<div class="fg"><label>${l}</label>${h}</div>`}).join('');
 mod(`<h2>${i<0?'Novo registro':'Editar'} – ${t.n}</h2><div class="gr" id="gr">${fs}</div><div class="ac">${i>=0?'<button class="x" data-mdel>Excluir</button>':''}<span style="flex:1"></span><button class="add" data-mx>Cancelar</button><button class="add p" data-ms>Salvar</button></div>`)}
function mod(h){const m=document.getElementById('md');m.innerHTML='<div class="mb">'+h+'</div>';m.style.display='flex'}
function closeM(){document.getElementById('md').style.display='none'}
function rd(){const o={};T[M.k].c.forEach(([f,,ty])=>{if(ty!=='=')o[f]=document.getElementById('f-'+f).value});return o}
function openPay(i){const r=D.vend[i],rs=N(r.val)-N(r.pago);M={pay:i};
 mod(`<h2>Receber pagamento – ${E(r.cli)}</h2><p>${E(r.ap)} · Valor ${F(r.val)} · Falta <b class="neg">${F(rs)}</b></p><div class="fg"><label>Valor recebido agora (R$)</label><input id="pv" type="number" step="0.01" value="${rs}"></div><div class="ac"><span style="flex:1"></span><button class="add" data-mx>Cancelar</button><button class="add p" data-mp>Confirmar</button></div>`)}
function keep(f){const y=scrollY;f();scrollTo(0,y)}
const TABS=[['painel','Painel'],['vend','Vendas'],['cons','Consertos'],['ped','Pedidos'],['cel','Celulares'],['est','Estoque'],['caixa','Caixa'],['nota','Nota'],['res','Resultados']];
function render(){
 document.getElementById('nav').innerHTML=TABS.map(([k,l])=>`<button data-tab="${k}" class="${k===tab?'on':''}">${l}</button>`).join('');
 document.getElementById('app').innerHTML=(({painel:panel,est,res:resu,cel:celv,caixa:cx,nota:notav})[tab]||(()=>tbl(tab)))()}
document.addEventListener('click',e=>{const t=e.target,b=t.closest('button');
 if(b){const d=b.dataset;
  if(d.tab){tab=d.tab;render()}
  else if(d.new)openM(d.new,-1);
  else if(d.q!==undefined){const r=D[d.k][+d.i];r.q=Math.max(0,N(r.q)+ +d.q);save();keep(render)}
  else if(d.pay!==undefined)openPay(+d.pay);
  else if('nadd' in d){NT.itens.push({d:'',q:1,v:''});render()}
  else if(d.nrm!==undefined){NT.itens.splice(+d.nrm,1);if(!NT.itens.length)NT.itens.push({d:'',q:1,v:''});render()}
  else if('npr' in d)window.print()
  else if('nsv' in d){if(!NT.num)NT.num='N'+String(D.notas.length+1).padStart(4,'0');const i=D.notas.findIndex(x=>x.num===NT.num),c=JSON.parse(JSON.stringify(NT));if(i<0)D.notas.push(c);else D.notas[i]=c;save();render()}
  else if('ncx' in d){D.caixa.push({data:NT.data,tipo:'Entrada',cat:'Conserto',desc:'Nota '+(NT.num||'')+' – '+NT.cli,forma:NT.pg,val:nTot(NT)});save();b.textContent='✓ Lançado'}
  else if('nnew' in d){NT=nNew();render()}
  else if('mx' in d)closeM();
  else if('ms' in d){const o=rd();if(M.i<0)D[M.k].push(o);else Object.assign(D[M.k][M.i],o);save();closeM();keep(render)}
  else if('mdel' in d){if(confirm('Excluir este registro?')){D[M.k].splice(M.i,1);save();closeM();keep(render)}}
  else if('mp' in d){const r=D.vend[M.pay],v=N(document.getElementById('pv').value);r.pago=N(r.pago)+v;if(v>0)D.caixa.push({data:new Date().toISOString().slice(0,10),tipo:'Entrada',cat:'Venda',desc:'Recebimento '+r.cli+' – '+r.ap,forma:'',val:v});if(N(r.val)-N(r.pago)<=0)r.st='Vendido e pago';else if(!r.st||r.st==='Anunciado')r.st='Recebendo pagamento';save();closeM();keep(render)}
  return}
 const nl=t.closest('[data-nl]');if(nl){NT=JSON.parse(JSON.stringify(D.notas[+nl.dataset.nl]));render();scrollTo(0,0);return}const tr=t.closest('tr[data-edit]');if(tr){openM(tr.dataset.edit,+tr.dataset.i);return}
 if(t.id==='md')closeM()});
document.addEventListener('input',e=>{const t=e.target,d=t.dataset;
 if(d.s!==undefined){Q[d.s]=t.value;document.getElementById('L-'+d.s).innerHTML=lst(d.s)}
 else if(d.n!==undefined){NT[d.n]=t.value;np()}else if(d.ni!==undefined){NT.itens[+d.ni][d.nf]=t.value;np()}else if(t.closest('#gr')){const o=rd();T[M.k].c.forEach(([f,,ty,x])=>{if(ty==='=')document.getElementById('r-'+f).textContent=F(x(o))})}});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeM()});
document.addEventListener('change',e=>{const d=e.target.dataset;
 if(d.y){Y=+e.target.value;render();return}if(d.cm){CM=e.target.value;render();return}if(d.cfg){D.cfg[d.cfg]=e.target.value}else return;save();render()});
function fix(){D.cfg=Object.assign(seed().cfg,D.cfg||{});D.cel=D.cel||[];D.caixa=D.caixa||[];D.notas=D.notas||[];D.comuns.forEach(r=>{if(r.cu===undefined)r.cu=D.cfg.pc;if(r.vu===undefined)r.vu=D.cfg.vc});D.priv.forEach(r=>{if(r.cu===undefined)r.cu=D.cfg.pp;if(r.vu===undefined)r.vu=D.cfg.vp});D.vend=D.vend.filter(r=>{if(r.cli==='(estoque)'){D.cel.push({mod:r.ap,imei:r.imei,venda:r.val,st:'Em estoque'});return false}return true})}
async function init(){
 try{const s=localStorage.getItem('mzcell');if(s)D=JSON.parse(s)}catch(e){}fix();
 render();
 try{const db=window.claude&&await claude.use('db');if(db){ref=db.doc('mzcell/state');const s=await ref.get();
  if(s.exists){D=JSON.parse(s.data().j);fix()}else{await ref.set({j:JSON.stringify(D)})}render();stat('✓ sincronizado')}}catch(e){ref=null}}
init();
</script></body></html>
